{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/editorial/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Changa))/i]",
        "message": "Font not provided by the design system. Available: Changa."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|attribution|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: children, tone, attribution."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quote|note|warning)$/]",
        "message": "<Callout> tone must be one of 'quote' | 'note' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductSpecTeaser'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<ProductSpecTeaser> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|number|tone|image|key|ref|className|style|children)$/]",
        "message": "<SectionCover> doesn't accept that prop. Declared props: kicker, title, number, tone, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCover'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|dark|light)$/]",
        "message": "<SectionCover> tone must be one of 'blue' | 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechnicalTableRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<TechnicalTableRow> doesn't accept that prop. Declared props: label, value."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
