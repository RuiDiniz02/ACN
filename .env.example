# Copy to .env and set the verified SMTP credentials of your hosting provider.
HOST=127.0.0.1
PORT=4173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender address, never the visitor's email.
MAIL_FROM=
# Exact public origin in production, e.g. https://www.acncutting.com
PUBLIC_ORIGIN=http://127.0.0.1:4173
